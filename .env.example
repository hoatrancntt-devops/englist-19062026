# Sao chép thành .env rồi điền. KHÔNG commit file .env.
#
#   cp .env.example .env
#
# Sinh giá trị ngẫu nhiên:
#   openssl rand -base64 48

# ---------------------------------------------------------------------------
# Bí mật — bắt buộc
# ---------------------------------------------------------------------------

# Mật khẩu Postgres.
POSTGRES_PASSWORD=

# Khoá gốc để mã hoá bí mật lưu trong DB (khoá API của nhà cung cấp AI,
# client secret của mail). Tối thiểu 32 ký tự.
#
# CẢNH BÁO: đổi giá trị này sau khi đã chạy = mất toàn bộ bí mật đã lưu.
# App sẽ coi như chưa cấu hình mail và AI, và sẽ KHÔNG báo lỗi ồn ào.
APP_MASTER_KEY=

# ---------------------------------------------------------------------------
# Postgres — có mặc định
# ---------------------------------------------------------------------------
POSTGRES_USER=efit
POSTGRES_DB=englishforit

# ---------------------------------------------------------------------------
# Tên miền và HTTPS
# ---------------------------------------------------------------------------

# Địa chỉ Caddy phục vụ.
#   - Có domain thật:   SITE_ADDRESS=english.example.com   (tự xin Let's Encrypt)
#   - Chỉ có IP:        SITE_ADDRESS=https://203.0.113.10   (chứng chỉ tự ký)
#   - Máy dev:          SITE_ADDRESS=:80
SITE_ADDRESS=:80

# Email nhận cảnh báo hết hạn chứng chỉ. Bỏ trống khi không dùng Let's Encrypt.
ACME_EMAIL=

# Đặt false khi chạy HTTP thuần trên localhost, còn lại luôn để true.
# Micro của trình duyệt KHÔNG chạy trên HTTP thuần (trừ localhost) —
# không có HTTPS thì toàn bộ phần luyện nói không dùng được.
COOKIES_SECURE=true

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------

# Để trống khi build tại chỗ. Dùng Azure Container Registry thì đặt
# IMAGE_REGISTRY=myregistry.azurecr.io
IMAGE_REGISTRY=englishforit

# Luôn dùng tag cụ thể trên production, đừng dùng 'latest' —
# nâng cấp và quay lui phải xác định được đúng bản nào.
IMAGE_TAG=local

# ---------------------------------------------------------------------------
# Tài khoản quản trị đầu tiên (chỉ dùng lúc seed)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
