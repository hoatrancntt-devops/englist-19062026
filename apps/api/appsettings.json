{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Postgres": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Content": {
    "SeedOnStartup": true,
    "Root": "content"
  },
  "Cookies": {
    "Secure": true
  },
  "Cors": {
    "DevOrigins": []
  },
  "PasswordHashing": {
    "MemorySizeKb": 32768,
    "Iterations": 3,
    "DegreeOfParallelism": 2
  },
  "Auth": {
    "SessionLifetimeDays": 30,
    "MaxFailedLogins": 8,
    "LockoutMinutes": 15,
    "MinPasswordLength": 10
  },
  "LearningPolicy": {
    "DailyMinutesTarget": 45,
    "StreakRequiresDailyTarget": true,
    "StreakRequiresAllFourSkills": true,
    "MaxStreakFreezeTokens": 2,
    "SpeechAudioRetentionDays": 45,
    "MasteryThreshold": 80,
    "PerSkillThreshold": 65,
    "ChallengePassThreshold": 85
  },
  "SecretProtection": {
    "MasterKey": ""
  },
  "AllowedHosts": "*"
}
